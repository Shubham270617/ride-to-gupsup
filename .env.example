# Frontend (Vite) — safe to expose in the browser bundle.
# Get these from your Supabase project: Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Copy this file to .env.local (gitignored) and fill in real values.
# Backend/server-only secrets (Strava keys, the Supabase service-role key)
# do NOT go here — see api/.env.example instead, and never commit real
# values for those.
