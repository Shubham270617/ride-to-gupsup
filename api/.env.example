# Server-only secrets for the /api serverless functions (the OAuth broker).
# NEVER prefix these with VITE_ — that would ship them to the browser.
# Locally: copy to api/.env.local (gitignored) for `vercel dev`.
# In production: set these in the Vercel project dashboard > Settings > Environment Variables.

# Same Supabase project as the frontend, but the SERVICE ROLE key (not the
# anon key) — Project Settings > API > service_role. This key bypasses Row
# Level Security, so treat it like a password and never expose it client-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where to send the browser back to after a successful OAuth login.
FRONTEND_URL=http://localhost:5173

# Strava: register a free app at https://developers.strava.com (Settings >
# My API Application). Authorization Callback Domain should be your site's
# domain (e.g. localhost for dev, ridetegupshup.in in production — no
# https://, no path).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Strava push subscription (api/webhooks/strava.js). Any random string —
# it's the shared secret Strava echoes back during the one-time handshake
# in scripts/register-strava-webhook.mjs.
STRAVA_WEBHOOK_VERIFY_TOKEN=

# REQUIRED. Guards the scheduled jobs in api/cron/ — the nightly media purge
# and the Strava history backfill. Both now REFUSE TO RUN without it rather
# than running unauthenticated, so the site's cron jobs will fail until this
# is set. Vercel sends it automatically as `Authorization: Bearer <value>`
# on scheduled invocations once the variable exists in the project.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=

# XFitConnect: no public API yet. Leave these blank — the "Continue with
# XFitConnect" button will show a friendly "not connected yet" message until
# real values are supplied here, no code changes needed.
XFITCONNECT_CLIENT_ID=
XFITCONNECT_CLIENT_SECRET=
XFITCONNECT_AUTHORIZE_URL=
XFITCONNECT_TOKEN_URL=

# The "Tapri" AI assistant (floating chat widget, see api/ai/chat.js). Get a
# key at https://console.anthropic.com (API Keys). Billed per message —
# Claude Haiku is the cheapest model, so typical chat volume costs very
# little, but it isn't free. Leave blank to keep the feature dormant: the
# widget still shows, but replies with a "not set up yet" message instead of
# calling the API.
ANTHROPIC_API_KEY=

# Forgot-password and welcome emails (api-lib/passwordReset.js and
# api-lib/welcomeEmail.js, served at /api/auth/account), sent through Brevo
# instead of Supabase's mailer (capped at 2 emails/hour). Free plan, about
# 300 emails a day: https://www.brevo.com -> SMTP & API -> API Keys.
# MAIL_FROM_EMAIL must be on a domain verified in Brevo (SPF + DKIM in DNS),
# or the emails land in spam.
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@rideteagupshup.com
MAIL_FROM_NAME=Ride Tea GupShup

# Secret used to hash reset codes and links before they're stored. Any long
# random string; changing it invalidates codes already sent.
# Generate one with:  openssl rand -hex 32
OTP_SECRET=
