{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/cron/strava-backfill.js": {
      "maxDuration": 60
    },
    "api/admin/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/purge-media",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/strava-backfill",
      "schedule": "30 21 * * *"
    }
  ]
}
